+  Future<(CustomWallpaper?, LaunchImportProblem?)> _adoptDirect(String path) async {
+    final (width, height) = await WallpaperImport.dimensions(path);
+    if (width <= 0 || height <= 0) return (null, LaunchImportProblem.unreadable);
