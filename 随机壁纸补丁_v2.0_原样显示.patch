diff --git a/app/lib/wallpaper/wallpaper_pool.dart b/app/lib/wallpaper/wallpaper_pool.dart
new file mode 100644
index 0000000..c2d8b22
--- /dev/null
+++ b/app/lib/wallpaper/wallpaper_pool.dart
@@ -0,0 +1,209 @@
+// 壁纸池：一个文件夹里的多张图片，随机挑一张当壁纸（lib/state/wallpaper_state.dart 的
+// CustomWallpaperController.rotate）。设置和 CustomWallpaper 一样存 shared_preferences 的一条
+// JSON；图片留在用户自己的文件夹里。
+//
+// 两条取图方式：
+//  - 检查（默认）：把挑中的那一张交给 WallpaperImport.keep()，走原有的导入（拷贝、15 MB 上限、
+//    PNG / JPEG / WebP、取边缘色、保留观感）。
+//  - 不检查（direct）：原图直接当壁纸，不拷贝、不按大小和格式拦，取景用原样模式。
+//
+// 原样显示（raw）管的是画法：整图等比放进屏幕、居中、不裁切，模糊和提亮 / 压暗归零。
+
+import 'dart:convert';
+import 'dart:io';
+import 'dart:math';
+
+import 'package:shared_preferences/shared_preferences.dart';
+
+/// 什么时候自动换一张；可以同时开着几个。
+enum WallpaperPoolTrigger {
+  /// 每次启动 App。
+  launch,
+
+  /// 切换聊天框（当前会话变了）。
+  chat,
+
+  /// 到时间。
+  interval,
+}
+
+/// 壁纸文件夹、自动更换的时机与间隔、上一张（随机时避开它）、以及两条取图/画法开关。
+class WallpaperPool {
+  const WallpaperPool({
+    this.directory = '',
+    this.triggers = const <WallpaperPoolTrigger>{},
+    this.minutes = defaultMinutes,
+    this.last = '',
+    this.raw = false,
+    this.direct = false,
+  });
+
+  static const prefsKey = 'wallpaper_pool';
+
+  /// 定时的档位（分钟）；「更换间隔」一行在这几档之间循环。
+  static const periods = [5, 15, 30, 60];
+  static const defaultMinutes = 30;
+
+  /// 一次最多认这么多张：几万张图的文件夹不整个读进来。
+  static const maxImages = 2000;
+
+  /// 挑中的图读不出来（太大、坏了）时，最多再试几张。
+  static const maxAttempts = 5;
+
+  /// 认的后缀，走检查那条路时用（和导入一致：PNG、JPEG、WebP）。
+  static const extensions = {'.png', '.jpg', '.jpeg', '.webp'};
+
+  final String directory;
+  final Set<WallpaperPoolTrigger> triggers;
+
+  /// 定时那一档的间隔（分钟）。
+  final int minutes;
+
+  /// 上一次挑中的原图路径。
+  final String last;
+
+  /// 原样显示：整图居中、不裁切，模糊和提亮 / 压暗归零。
+  final bool raw;
+
+  /// 不检查：原图直接当壁纸，不拷贝、不按大小和格式拦（认不出的格式解码不出来才跳过）。
+  final bool direct;
+
+  bool has(WallpaperPoolTrigger trigger) => triggers.contains(trigger);
+
+  WallpaperPool copyWith({
+    String? directory,
+    Set<WallpaperPoolTrigger>? triggers,
+    int? minutes,
+    String? last,
+    bool? raw,
+    bool? direct,
+  }) =>
+      WallpaperPool(
+        directory: directory ?? this.directory,
+        triggers: triggers ?? this.triggers,
+        minutes: minutes ?? this.minutes,
+        last: last ?? this.last,
+        raw: raw ?? this.raw,
+        direct: direct ?? this.direct,
+      );
+
+  /// [trigger] 开着或关掉。
+  WallpaperPool toggled(WallpaperPoolTrigger trigger, bool on) {
+    final next = {...triggers};
+    if (on) {
+      next.add(trigger);
+    } else {
+      next.remove(trigger);
+    }
+    return copyWith(triggers: next);
+  }
+
+  /// 下一档间隔：5 → 15 → 30 → 60 → 5（认不出的值从默认档起算）。
+  WallpaperPool nextPeriod() {
+    final at = periods.indexOf(minutes);
+    final from = at < 0 ? periods.indexOf(defaultMinutes) : at;
+    return copyWith(minutes: periods[(from + 1) % periods.length]);
+  }
+
+  Map<String, Object?> toJson() => {
+    'directory': directory,
+    'triggers': [for (final trigger in triggers) trigger.name],
+    'minutes': minutes,
+    'last': last,
+    'raw': raw,
+    'direct': direct,
+  };
+
+  static WallpaperPool fromJson(Object? raw) {
+    if (raw is! Map) return const WallpaperPool();
+    final directory = raw['directory'];
+    final triggers = raw['triggers'];
+    final minutes = raw['minutes'];
+    final last = raw['last'];
+    return WallpaperPool(
+      directory: directory is String ? directory : '',
+      triggers: triggers is List
+          ? {
+              for (final name in triggers)
+                ...WallpaperPoolTrigger.values.where((trigger) => trigger.name == name),
+            }
+          : const <WallpaperPoolTrigger>{},
+      minutes: minutes is int && periods.contains(minutes) ? minutes : defaultMinutes,
+      last: last is String ? last : '',
+      raw: raw['raw'] == true,
+      direct: raw['direct'] == true,
+    );
+  }
+
+  /// 存着的那份；没有、坏了就当没设置过。
+  static Future<WallpaperPool> load([SharedPreferences? prefs]) async {
+    try {
+      final store = prefs ?? await SharedPreferences.getInstance();
+      final stored = store.getString(prefsKey);
+      if (stored == null) return const WallpaperPool();
+      return fromJson(jsonDecode(stored));
+    } catch (_) {
+      return const WallpaperPool();
+    }
+  }
+
+  static Future<void> save(WallpaperPool pool) async {
+    final prefs = await SharedPreferences.getInstance();
+    await prefs.setString(prefsKey, jsonEncode(pool.toJson()));
+  }
+
+  /// [directory] 里（含子文件夹）能当壁纸的图片。排序让每次列举的顺序一样 —— 顺序不定的话
+  /// 「随机」会退化成「跟着文件系统的返回顺序走」。不检查那条路用的是 [allImages]。
+  static Future<List<String>> images(String directory, {int limit = maxImages}) async {
+    if (directory.isEmpty) return const [];
+    try {
+      final dir = Directory(directory);
+      if (!dir.existsSync()) return const [];
+      final found = <String>[];
+      await for (final entity in dir.list(recursive: true, followLinks: false)) {
+        if (entity is! File) continue;
+        if (!extensions.contains(extensionOf(entity.path))) continue;
+        found.add(entity.path);
+        if (found.length >= limit) break;
+      }
+      found.sort();
+      return found;
+    } catch (_) {
+      return const [];
+    }
+  }
+
+  /// 不检查那条路用的列举：不管后缀，只要是文件就收（认不出的格式在解码时会被跳过）。
+  static Future<List<String>> allImages(String directory, {int limit = maxImages}) async {
+    if (directory.isEmpty) return const [];
+    try {
+      final dir = Directory(directory);
+      if (!dir.existsSync()) return const [];
+      final found = <String>[];
+      await for (final entity in dir.list(recursive: true, followLinks: false)) {
+        if (entity is! File) continue;
+        found.add(entity.path);
+        if (found.length >= limit) break;
+      }
+      found.sort();
+      return found;
+    } catch (_) {
+      return const [];
+    }
+  }
+
+  /// [path] 的小写后缀（含点）；没有后缀时空串。
+  static String extensionOf(String path) {
+    final name = path.split('/').last;
+    final dot = name.lastIndexOf('.');
+    return dot <= 0 ? '' : name.substring(dot).toLowerCase();
+  }
+
+  /// 随机挑一张，避开 [current]（连着两次同一张很出戏）；只有一张时就用那一张。
+  static String? pick(List<String> images, String? current, {Random? random}) {
+    if (images.isEmpty) return null;
+    final choices = images.length > 1 && current != null ? images.where((path) => path != current).toList() : images;
+    final from = choices.isEmpty ? images : choices;
+    return from[(random ?? Random()).nextInt(from.length)];
+  }
+}
diff --git a/app/test/wallpaper/wallpaper_pool_test.dart b/app/test/wallpaper/wallpaper_pool_test.dart
new file mode 100644
index 0000000..9f15209
--- /dev/null
+++ b/app/test/wallpaper/wallpaper_pool_test.dart
@@ -0,0 +1,191 @@
+// 壁纸池（lib/wallpaper/wallpaper_pool.dart + wallpaper_state 的 rotate）：文件夹列举与过滤、
+// 随机避开上一张、设置的读写与回落、原样显示的取景、以及两条取图链路（检查 / 不检查）。
+
+import 'dart:convert';
+import 'dart:io';
+import 'dart:ui' show Rect, Size;
+
+import 'package:dsh_app/state/wallpaper_state.dart';
+import 'package:dsh_app/wallpaper/custom_wallpaper.dart';
+import 'package:dsh_app/wallpaper/wallpaper_import.dart';
+import 'package:dsh_app/wallpaper/wallpaper_pool.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:shared_preferences/shared_preferences.dart';
+
+import 'support.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  late Directory pool;
+
+  setUp(() async {
+    pool = await Directory.systemTemp.createTemp('wallpaper-pool');
+  });
+
+  tearDown(() async {
+    if (pool.existsSync()) await pool.delete(recursive: true);
+  });
+
+  Future<void> put(String name, String bytes) async {
+    final file = File('${pool.path}/$name');
+    await file.create(recursive: true);
+    await file.writeAsString(bytes);
+  }
+
+  test('列出文件夹里的图片：只认 PNG / JPEG / WebP，含子文件夹，顺序稳定', () async {
+    await put('b.JPG', 'b');
+    await put('a.png', 'a');
+    await put('c.gif', 'c');
+    await put('d.txt', 'd');
+    await put('sub/e.webp', 'e');
+
+    expect(await WallpaperPool.images(pool.path), [
+      '${pool.path}/a.png',
+      '${pool.path}/b.JPG',
+      '${pool.path}/sub/e.webp',
+    ]);
+    expect(await WallpaperPool.images('${pool.path}/missing'), isEmpty);
+    expect(await WallpaperPool.images(''), isEmpty);
+  });
+
+  test('不检查那条路的列举：不管后缀', () async {
+    await put('a.png', 'a');
+    await put('b.gif', 'b');
+    await put('c.txt', 'c');
+
+    expect(await WallpaperPool.allImages(pool.path), [
+      '${pool.path}/a.png',
+      '${pool.path}/b.gif',
+      '${pool.path}/c.txt',
+    ]);
+  });
+
+  test('随机挑一张避开上一张；只有一张时就是它', () {
+    expect(WallpaperPool.pick(const [], '/a.png'), isNull);
+    expect(WallpaperPool.pick(const ['/a.png'], '/a.png'), '/a.png');
+    for (var i = 0; i < 20; i++) {
+      expect(WallpaperPool.pick(const ['/a.png', '/b.png'], '/a.png'), '/b.png');
+    }
+  });
+
+  test('原样显示的取景：整图等比居中、不裁切，比例与屏幕一致', () {
+    // 宽图（2:1）在 1:1 的屏幕上：整图高度都在，宽度居中。
+    final wide = CustomWallpaper(path: '/a.jpg', width: 2000, height: 1000, raw: true);
+    final w = wide.windowIn(const Size(2000, 1000), const Size(800, 800));
+    expect(w.top, 0);
+    expect(w.bottom, 1000);
+    expect(w.width, 800);
+    expect(w.left, 600);
+
+    // 高图（1:2）在 1:1 的屏幕上：整图宽度都在，高度居中。
+    final tall = CustomWallpaper(path: '/b.jpg', width: 1000, height: 2000, raw: true);
+    final t = tall.windowIn(const Size(1000, 2000), const Size(800, 800));
+    expect(t.left, 0);
+    expect(t.right, 1000);
+    expect(t.height, 800);
+    expect(t.top, 600);
+
+    // 比例与屏幕一致：就是整图。
+    final same = CustomWallpaper(path: '/c.jpg', width: 800, height: 400, raw: true);
+    expect(same.windowIn(const Size(800, 400), const Size(800, 400)), Rect.fromLTWH(0, 0, 800, 400));
+
+    // 没开原样显示时还是覆盖（裁切）那套老行为。
+    final cover = CustomWallpaper(path: '/d.jpg', width: 2000, height: 1000);
+    expect(cover.windowIn(const Size(2000, 1000), const Size(800, 800)).width, 1600);
+  });
+
+  test('设置的读写与回落', () {
+    final pool = WallpaperPool(directory: '/pics', minutes: 15, raw: true, direct: true);
+    final back = WallpaperPool.fromJson(jsonDecode(jsonEncode(pool.toJson())));
+    expect(back.directory, '/pics');
+    expect(back.minutes, 15);
+    expect(back.triggers, isEmpty);
+    expect(back.raw, isTrue);
+    expect(back.direct, isTrue);
+    expect(back.toggled(WallpaperPoolTrigger.chat, true).has(WallpaperPoolTrigger.chat), isTrue);
+    expect(back.toggled(WallpaperPoolTrigger.chat, true).toggled(WallpaperPoolTrigger.chat, false).triggers, isEmpty);
+    expect(back.nextPeriod().minutes, 30);
+    // 认不出的间隔从默认档起算：5 → 15 → 30 → 60 → 5。
+    expect(const WallpaperPool(minutes: 7).nextPeriod().minutes, 5);
+    expect(const WallpaperPool(minutes: 60).nextPeriod().minutes, 5);
+
+    final broken = WallpaperPool.fromJson({'directory': 7, 'triggers': 'chat', 'minutes': 9, 'last': null});
+    expect(broken.directory, '');
+    expect(broken.triggers, isEmpty);
+    expect(broken.minutes, WallpaperPool.defaultMinutes);
+    expect(broken.last, '');
+    expect(broken.raw, isFalse);
+    expect(broken.direct, isFalse);
+    expect(WallpaperPool.fromJson(null).directory, '');
+  });
+
+  group('从池里换一张', () {
+    late Directory output;
+
+    setUp(() async {
+      output = await Directory.systemTemp.createTemp('wallpaper-copy');
+      // 坏图排在前面（PNG 头、解不出来），好图是 720 × 1280 的 JPEG。
+      await File(brokenFixture).copy('${pool.path}/01_broken.png');
+      await File(brightFixture).copy('${pool.path}/02_bright.jpg');
+    });
+
+    tearDown(() async {
+      if (output.existsSync()) await output.delete(recursive: true);
+    });
+
+    ProviderContainer container() {
+      final container = ProviderContainer(
+        overrides: [wallpaperImportProvider.overrideWithValue(WallpaperImport(directory: () async => output))],
+      );
+      addTearDown(container.dispose);
+      return container;
+    }
+
+    test('检查那条路：坏图跳过，换成能用的那一张；池里的原图不动', () async {
+      SharedPreferences.setMockInitialValues({
+        WallpaperPool.prefsKey: jsonEncode(WallpaperPool(directory: pool.path).toJson()),
+      });
+      final provider = container();
+      final notifier = provider.read(customWallpaperProvider.notifier);
+      for (var i = 0; i < 5; i++) {
+        expect(await notifier.rotate(force: true), isTrue);
+        final wallpaper = provider.read(customWallpaperProvider).value!;
+        expect(wallpaper.path, startsWith(output.path));
+        expect(File(wallpaper.path).existsSync(), isTrue);
+      }
+      final stored = await WallpaperPool.load();
+      expect(stored.last, '${pool.path}/02_bright.jpg');
+      expect(File(stored.last).existsSync(), isTrue);
+      expect(File('${pool.path}/01_broken.png').existsSync(), isTrue);
+    });
+
+    test('不检查那条路：原图直接当壁纸，不拷贝、不模糊不压暗', () async {
+      SharedPreferences.setMockInitialValues({
+        WallpaperPool.prefsKey: jsonEncode(
+          WallpaperPool(directory: pool.path, direct: true, raw: true).toJson(),
+        ),
+      });
+      final provider = container();
+      expect(await provider.read(customWallpaperProvider.notifier).rotate(force: true), isTrue);
+      final wallpaper = provider.read(customWallpaperProvider).value!;
+      expect(wallpaper.path, '${pool.path}/02_bright.jpg'); // 原图本身，没有被拷走
+      expect(File(wallpaper.path).existsSync(), isTrue);
+      expect(wallpaper.blur, 0);
+      expect(wallpaper.lighten, 0);
+      expect(wallpaper.dim, 0);
+      expect(wallpaper.raw, isTrue);
+    });
+
+    test('文件夹里没有能用的图：不换，也不报错', () async {
+      await File('${pool.path}/02_bright.jpg').delete();
+      SharedPreferences.setMockInitialValues({
+        WallpaperPool.prefsKey: jsonEncode(WallpaperPool(directory: pool.path).toJson()),
+      });
+      final provider = container();
+      expect(await provider.read(customWallpaperProvider.notifier).rotate(force: true), isFalse);
+      expect(provider.read(customWallpaperProvider).value, isNull);
+    });
+  });
+}
