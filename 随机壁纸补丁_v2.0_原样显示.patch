+  /// [force] 跳过冷却 —— 设置页的「换一张」按的每一次都要算数。
+  Future<bool> rotate({bool force = false}) async {
+    final pool = await ref.read(wallpaperPoolProvider.future);
+    if (pool.directory.isEmpty || _rotating) return false;
